;; #39: timer + message + cancellable watch + data-only webhook + budget.
(require "std/string")
(require "runtime/inbox")

(define (line k v) (display k) (display "=") (display v) (newline))

(define s (inbox:new (hash "budget_ms" 10)))
(define s (inbox:message! s "hello" "stdin"))
(define s (inbox:timer! s "t1" 100 "wake"))
(define s (inbox:watch! s "w1" "market"))
(define s (inbox:cancel! s "w1"))
(define s (inbox:webhook s "grant: http-post"))
(define r (inbox:tick s 150))
(line "ok" (hash-ref r "ok"))
(line "delivered" (length (hash-ref r "delivered")))
(line "timers" (hash-ref r "timers"))
(line "active-watches" (hash-ref r "active_watches"))
(line "webhook" (hash-ref s "last_webhook"))
(line "degraded" (string-join (hash-ref r "degraded" '()) ","))
(define r2 (inbox:tick s 151))
(line "second-delivered" (length (hash-ref r2 "delivered")))
(define frozen (inbox:new (hash "budget_ms" 1)))
(define frozen (inbox:tick frozen 0))
(define frozen-r (inbox:tick frozen 1))
(line "frozen" (hash-ref frozen-r "frozen"))
