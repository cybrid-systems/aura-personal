;; #41: PIN, challenge, withdraw, cross-session save/load.
(require "std/string")
(require "runtime/memory")

(define (line k v) (display k) (display "=") (display v) (newline))

(define s (memory:new (hash "tenant" 1)))
(define s (memory:remember s "favorite color is blue" "user"))
(define s (memory:remember s "meeting at 10" "ingest"))
(define s (memory:pin s "mem-1"))
(line "recall-blue" (length (memory:recall s "blue")))
(line "authority" (memory:authority? s "mem-1"))
(define s (memory:challenge s "mem-2" "stale"))
(line "challenge-authority" (memory:authority? s "mem-2"))
(line "challenge-recall" (length (memory:recall s "meeting")))
(define s (memory:withdraw s "mem-1" "user changed"))
(line "withdraw-authority" (memory:authority? s "mem-1"))
(line "withdraw-recall" (length (memory:recall s "blue")))
(define path "out/memory-test.json")
(line "save" (hash-ref (memory:save s path) "ok"))
(define loaded (memory:load path))
(line "loaded-entries" (length (hash-ref loaded "entries")))
(line "loaded-pinned" (let ((e (car (filter (lambda (x) (equal? (hash-ref x "id") "mem-1")) (hash-ref loaded "entries"))))) (hash-ref e "pinned")))
(line "loaded-withdrawn" (length (memory:recall loaded "blue")))
